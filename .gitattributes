# Set default behavior to automatically normalize line endings to Unix (LF)
* text=auto eol=lf

# Source code and configuration files
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.webp binary
*.dll binary
*.exe binary
*.so binary
*.dylib binary
*.db binary
*.sqlite3 binary
